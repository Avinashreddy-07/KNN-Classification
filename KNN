import numpy as np
import matplotlib.pyplot as plt
from sklearn import datasets
from sklearn.neighbors import KNeighborsClassifier
from matplotlib.colors import ListedColormap

# 1. Load Iris dataset (only 2 features: sepal length, sepal width)
iris = datasets.load_iris()
X, y = iris.data[:, :2], iris.target

# Mesh grid for plotting boundaries
x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1
y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1
xx, yy = np.meshgrid(np.arange(x_min, x_max, 0.02),
                     np.arange(y_min, y_max, 0.02))

# Different k values
ks = [1, 3, 5, 10]

# Create subplots (2x2 grid)
fig, axes = plt.subplots(2, 2, figsize=(14, 10))

for ax, k in zip(axes.flat, ks):
    # 2. Train kNN
    clf = KNeighborsClassifier(n_neighbors=k)
    clf.fit(X, y)

    # 3. Predict decision boundaries
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()]).reshape(xx.shape)

    # Color maps
    cmap_light = ListedColormap(['#FFAAAA', '#AAFFAA', '#AAAAFF'])
    cmap_bold = ListedColormap(['#FF0000', '#00FF00', '#0000FF'])

    # Plot
    ax.contourf(xx, yy, Z, alpha=0.4, cmap=cmap_light)
    ax.scatter(X[:, 0], X[:, 1], c=y, cmap=cmap_bold, edgecolors='k', s=40)
    ax.set_title(f"k = {k}")

fig.suptitle("kNN Decision Boundaries on Iris (Sepal length vs Sepal width)", fontsize=16)
plt.show()
